.page {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.login-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.auth-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.status-card {
  text-align: center;
  padding: 48rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.status-card.status-pending {
  background: #fff8e1;
}

.status-card.status-approved {
  background: #e8f5e9;
}

.status-card.status-rejected {
  background: #ffebee;
}

.status-card.status-none {
  background: #f5f5f5;
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 26rpx;
  color: #666;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  height: 72rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.code-group {
  display: flex;
  gap: 16rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 160rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  font-size: 26rpx;
  background: #ff6b6b;
  color: #fff;
  border-radius: 12rpx;
  margin: 0;
}

.code-btn.disabled {
  background: #ccc;
}

.code-btn::after {
  border: none;
}

.upload-area {
  width: 240rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.upload-icon {
  font-size: 48rpx;
  font-weight: 300;
}

.upload-text {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.btn-login, .btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  margin-top: 24rpx;
}

.btn-login::after, .btn-submit::after {
  border: none;
}
