.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.form-scroll {
  flex: 1;
  overflow: hidden;
}

.form-section {
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.type-tabs {
  display: flex;
  gap: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  background: #fff5f5;
  border-color: #ff6b6b;
  color: #ff6b6b;
}

.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: calc(33.33% - 11rpx);
  height: 180rpx;
}

.image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.image-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
}

.image-add {
  width: calc(33.33% - 11rpx);
  height: 180rpx;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.add-icon {
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.add-count {
  font-size: 20rpx;
  margin-top: 4rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-row {
  display: flex;
  gap: 24rpx;
}

.form-item.half {
  flex: 1;
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input, .picker {
  height: 72rpx;
  line-height: 72rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}

.picker {
  color: #999;
}

.picker-group {
  display: flex;
  gap: 12rpx;
}

.picker-group .picker {
  flex: 1;
  text-align: center;
  padding: 0;
}

.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.checkbox-item {
  padding: 16rpx 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
}

.checkbox-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
  color: #ff6b6b;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.footer {
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  gap: 20rpx;
  border-top: 1rpx solid #eee;
}

.btn-save, .btn-submit {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  border-radius: 40rpx;
  margin: 0;
}

.btn-save {
  background: #f5f5f5;
  color: #666;
}

.btn-submit {
  background: #ff6b6b;
  color: #fff;
}

.btn-save::after, .btn-submit::after {
  border: none;
}
