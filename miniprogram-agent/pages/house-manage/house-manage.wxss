.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.filter-tabs {
  display: flex;
  background: #fff;
  padding: 0 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #ff6b6b;
  font-weight: 500;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #ff6b6b;
  border-radius: 2rpx;
}

.house-list {
  flex: 1;
  padding: 24rpx;
}

.house-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.house-image {
  width: 220rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.house-info {
  flex: 1;
  padding: 20rpx;
  min-width: 0;
}

.house-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  overflow: hidden;
}

.house-title text:first-child {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.status-tag.status-online {
  background: #e8f5e9;
  color: #4caf50;
}

.status-tag.status-offline {
  background: #f5f5f5;
  color: #999;
}

.status-tag.status-pending {
  background: #fff3e0;
  color: #ff9800;
}

.house-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.house-desc text {
  margin-right: 8rpx;
}

.house-address {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.price {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.unit {
  font-size: 20rpx;
  color: #ff6b6b;
}

.house-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
  color: #666;
}

.action-btn.online {
  color: #4caf50;
  border-color: #4caf50;
}

.action-btn.offline {
  color: #ff9800;
  border-color: #ff9800;
}

.action-btn.delete {
  color: #f44336;
  border-color: #f44336;
}

.house-stats {
  display: flex;
  gap: 20rpx;
  font-size: 20rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
  display: block;
}

.empty-btn {
  padding: 16rpx 64rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.empty-btn::after {
  border: none;
}

.loading, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #ff6b6b;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}
