<view class="page">
  <view class="date-selector">
    <view class="date-item {{dateType === 'week' ? 'active' : ''}}" bindtap="selectDate" data-type="week">本周</view>
    <view class="date-item {{dateType === 'month' ? 'active' : ''}}" bindtap="selectDate" data-type="month">本月</view>
    <view class="date-item {{dateType === 'quarter' ? 'active' : ''}}" bindtap="selectDate" data-type="quarter">本季</view>
  </view>

  <view class="overview-card">
    <view class="overview-title">数据概览</view>
    <view class="overview-grid">
      <view class="overview-item">
        <text class="number">{{overview.totalViews}}</text>
        <text class="label">总浏览量</text>
        <text class="trend up">↑ 12%</text>
      </view>
      <view class="overview-item">
        <text class="number">{{overview.totalFavorites}}</text>
        <text class="label">总收藏量</text>
        <text class="trend up">↑ 8%</text>
      </view>
      <view class="overview-item">
        <text class="number">{{overview.totalAppointments}}</text>
        <text class="label">预约量</text>
        <text class="trend up">↑ 15%</text>
      </view>
      <view class="overview-item">
        <text class="number">{{overview.totalCalls}}</text>
        <text class="label">咨询电话</text>
        <text class="trend down">↓ 3%</text>
      </view>
    </view>
  </view>

  <view class="chart-card">
    <view class="chart-title">浏览趋势</view>
    <view class="chart-container">
      <view class="chart-bars">
        <view class="bar-item" wx:for="{{trendData}}" wx:key="date">
          <view class="bar" style="height: {{item.percent}}%; background: linear-gradient(to top, #ff6b6b, #ffa8a8);"></view>
          <text class="bar-label">{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="ranking-card">
    <view class="ranking-title">房源排行</view>
    <view class="ranking-item" wx:for="{{houseRanking}}" wx:key="_id" wx:for-index="idx">
      <view class="rank-num {{idx < 3 ? 'top' : ''}}">{{idx + 1}}</view>
      <image class="house-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="house-info">
        <view class="house-title">{{item.title}}</view>
        <view class="house-stats">
          <text>浏览 {{item.views}}</text>
          <text>收藏 {{item.favorites}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
