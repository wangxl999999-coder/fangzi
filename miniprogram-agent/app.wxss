page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.btn {
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-primary {
  background: #ff6b6b;
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #ff6b6b;
  border: 1rpx solid #ff6b6b;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tag-red {
  background: #ffebee;
  color: #f44336;
}

.tag-orange {
  background: #fff3e0;
  color: #ff9800;
}

.tag-blue {
  background: #e3f2fd;
  color: #2196f3;
}

.tag-green {
  background: #e8f5e9;
  color: #4caf50;
}
