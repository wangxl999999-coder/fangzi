page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
}

view, text, button, input, image {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.price {
  color: #ff6b6b;
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
  color: #ff6b6b;
  font-weight: normal;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  background: #f0f0f0;
  color: #666;
}

.tag-red {
  background: #ffecec;
  color: #ff6b6b;
}

.tag-green {
  background: #e8f5e9;
  color: #4caf50;
}

.tag-blue {
  background: #e3f2fd;
  color: #2196f3;
}

.tag-orange {
  background: #fff3e0;
  color: #ff9800;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
}

.btn-disabled {
  background: #ccc;
  color: #fff;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-title .more {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 24rpx 0;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}

.empty .icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.loading {
  padding: 40rpx;
  text-align: center;
  color: #999;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
