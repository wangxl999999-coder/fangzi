.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.filter-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
}

.filter-item .arrow {
  font-size: 20rpx;
  margin-left: 4rpx;
}

.project-list {
  flex: 1;
  padding: 24rpx;
}

.project-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.project-image {
  width: 100%;
  height: 360rpx;
}

.project-info {
  padding: 24rpx;
}

.project-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.project-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.price-unit {
  font-size: 24rpx;
  color: #ff6b6b;
  margin-left: 4rpx;
}

.price-total {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

.project-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.project-desc text {
  margin-right: 8rpx;
}

.project-house-types {
  margin-bottom: 12rpx;
}

.project-features {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.loading, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
}
