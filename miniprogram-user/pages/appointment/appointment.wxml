<view class="page">
  <view class="tabs">
    <view class="tab {{activeTab === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-tab="pending">待确认</view>
    <view class="tab {{activeTab === 'confirmed' ? 'active' : ''}}" bindtap="switchTab" data-tab="confirmed">已确认</view>
    <view class="tab {{activeTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">已完成</view>
    <view class="tab {{activeTab === 'cancelled' ? 'active' : ''}}" bindtap="switchTab" data-tab="cancelled">已取消</view>
  </view>

  <scroll-view scroll-y class="appointment-list" bindscrolltolower="loadMore">
    <view class="appointment-card" wx:for="{{appointmentList}}" wx:key="_id">
      <view class="card-header">
        <text class="status status-{{item.status}}">{{getStatusText(item.status)}}</text>
        <text class="date">{{item.date}} {{item.time}}</text>
      </view>
      <view class="house-info" bindtap="goHouseDetail" data-id="{{item.houseId}}">
        <image class="house-image" src="{{item.houseImage}}" mode="aspectFill"></image>
        <view class="house-detail">
          <view class="house-title">{{item.houseTitle}}</view>
          <view class="house-price">
            <text class="price">¥{{item.housePrice}}</text>
            <text class="unit">{{item.priceUnit === 'total' ? '万' : '/月'}}</text>
          </view>
          <view class="house-address">{{item.houseAddress}}</view>
        </view>
      </view>
      <view class="agent-info">
        <text class="agent-label">带看人：{{item.agentName}}</text>
        <text class="agent-phone" bindtap="callAgent" data-phone="{{item.agentPhone}}">📞 联系</text>
      </view>
      <view class="card-footer" wx:if="{{item.status === 'pending'}}">
        <button class="btn-cancel" bindtap="cancelAppointment" data-id="{{item._id}}">取消预约</button>
      </view>
      <view class="card-footer" wx:if="{{item.status === 'confirmed'}}">
        <button class="btn-complete" bindtap="completeAppointment" data-id="{{item._id}}">确认完成</button>
      </view>
    </view>

    <view class="empty" wx:if="{{appointmentList.length === 0 && !loading}}">
      <text class="empty-icon">📅</text>
      <text class="empty-text">暂无预约记录</text>
      <button class="empty-btn" bindtap="goHome">去看房</button>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="no-more" wx:if="{{noMore && appointmentList.length > 0}}">— 没有更多了 —</view>
  </scroll-view>
</view>
