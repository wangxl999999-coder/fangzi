.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #ff6b6b;
  font-weight: 500;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background: #ff6b6b;
  border-radius: 2rpx;
}

.appointment-list {
  flex: 1;
  padding: 24rpx;
}

.appointment-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-pending {
  background: #fff3e0;
  color: #ff9800;
}

.status-confirmed {
  background: #e3f2fd;
  color: #2196f3;
}

.status-completed {
  background: #e8f5e9;
  color: #4caf50;
}

.status-cancelled {
  background: #ffebee;
  color: #f44336;
}

.date {
  font-size: 24rpx;
  color: #999;
}

.house-info {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.house-image {
  width: 180rpx;
  height: 135rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.house-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.house-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-price {
  margin: 8rpx 0;
}

.price {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.unit {
  font-size: 20rpx;
  color: #ff6b6b;
}

.house-address {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.agent-label {
  font-size: 26rpx;
  color: #666;
}

.agent-phone {
  font-size: 26rpx;
  color: #ff6b6b;
}

.card-footer {
  padding: 16rpx 24rpx 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.btn-cancel, .btn-complete {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  margin: 0;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-complete {
  background: #ff6b6b;
  color: #fff;
}

.btn-cancel::after, .btn-complete::after {
  border: none;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
  display: block;
}

.empty-btn {
  padding: 16rpx 64rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.empty-btn::after {
  border: none;
}

.loading, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
