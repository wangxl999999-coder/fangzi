.page {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.tools-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.tool-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin: 0 auto 16rpx;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.tool-desc {
  font-size: 22rpx;
  color: #999;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.calc-list {
  border-top: 1rpx solid #f0f0f0;
}

.calc-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.calc-item:last-child {
  border-bottom: none;
}

.calc-name {
  font-size: 28rpx;
  color: #333;
}

.calc-arrow {
  font-size: 28rpx;
  color: #ccc;
}
