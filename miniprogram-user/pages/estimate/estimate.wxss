.page {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.input, .picker {
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  color: #333;
}

.picker {
  color: #999;
}

.radio-group {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.radio-item {
  padding: 16rpx 32rpx;
  border: 1rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
}

.radio-item.active {
  background: #ff6b6b;
  color: #fff;
  border-color: #ff6b6b;
}

.btn-estimate {
  background: #ff6b6b;
  color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.btn-estimate::after {
  border: none;
}

.result-section {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.result-card {
  padding: 48rpx 32rpx;
  text-align: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.result-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.result-price {
  margin-bottom: 12rpx;
}

.price {
  font-size: 64rpx;
  font-weight: bold;
}

.unit {
  font-size: 28rpx;
  opacity: 0.9;
}

.result-unit-price {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
}

.result-range {
  font-size: 22rpx;
  opacity: 0.8;
}

.factors-section {
  padding: 32rpx;
}

.factors-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.factor-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.factor-name {
  width: 140rpx;
  font-size: 26rpx;
  color: #666;
}

.factor-bar {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.factor-progress {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 6rpx;
}

.factor-score {
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  color: #ff6b6b;
  font-weight: bold;
}
