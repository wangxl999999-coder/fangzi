.page {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.input {
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.radio-group {
  display: flex;
  gap: 32rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.radio-item.active {
  color: #ff6b6b;
}

.radio {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  margin-right: 12rpx;
  position: relative;
}

.radio-item.active .radio {
  border-color: #ff6b6b;
}

.radio-item.active .radio::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background: #ff6b6b;
  border-radius: 50%;
}

.btn-calc {
  background: #ff6b6b;
  color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.btn-calc::after {
  border: none;
}

.result-section {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.result-card {
  padding: 32rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-label {
  font-size: 28rpx;
  color: #666;
}

.result-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #f9f9f9;
}

.detail-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.detail-arrow {
  font-size: 24rpx;
  color: #999;
}

.detail-list {
  padding: 0 16rpx;
}

.detail-item {
  display: flex;
  padding: 20rpx 8rpx;
  font-size: 22rpx;
  color: #666;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item.header {
  font-weight: bold;
  color: #999;
  background: #f9f9f9;
  margin: 0 -16rpx;
  padding: 20rpx 24rpx;
}

.detail-item text {
  flex: 1;
  text-align: center;
}

.detail-scroll {
  max-height: 600rpx;
}
