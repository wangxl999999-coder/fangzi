<view class="page">
  <view class="logo-section">
    <view class="logo">🏠</view>
    <view class="title">找房网</view>
    <view class="subtitle">专业的房产服务平台</view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <text class="prefix">+86</text>
      <input class="phone-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-item">
      <input class="code-input" type="number" maxlength="6" placeholder="请输入验证码" value="{{form.code}}" bindinput="onInput" data-field="code" />
      <button class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode" disabled="{{countdown > 0}}">
        {{countdown > 0 ? countdown + 's后重发' : '获取验证码'}}
      </button>
    </view>
  </view>

  <view class="agreement">
    <text class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgree">{{agreed ? '✓' : ''}}</text>
    <text class="agreement-text">我已阅读并同意</text>
    <text class="link">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="link">《隐私政策》</text>
  </view>

  <button class="login-btn" bindtap="login">登录</button>

  <view class="other-login">
    <view class="divider">
      <text class="line"></text>
      <text class="text">其他登录方式</text>
      <text class="line"></text>
    </view>
    <view class="wx-login" bindtap="wxLogin">
      <text class="wx-icon">💬</text>
      <text class="wx-text">微信一键登录</text>
    </view>
  </view>
</view>
