.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.count {
  font-size: 26rpx;
  color: #666;
}

.clear-btn {
  font-size: 26rpx;
  color: #ff6b6b;
}

.house-list {
  flex: 1;
  padding: 0 24rpx;
}

.group {
  margin-bottom: 24rpx;
}

.group-title {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 8rpx;
}

.house-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.house-image {
  width: 200rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.house-info {
  flex: 1;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.house-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-desc {
  font-size: 24rpx;
  color: #999;
}

.house-desc text {
  margin-right: 8rpx;
}

.price {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.unit {
  font-size: 20rpx;
  color: #ff6b6b;
}

.loading, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 16rpx 64rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.empty-btn::after {
  border: none;
}
