.page {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab.active {
  background: #ff6b6b;
  color: #fff;
}

.search-box {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}

.search-input {
  height: 64rpx;
  font-size: 28rpx;
}

.policy-list {
  gap: 20rpx;
}

.policy-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.policy-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #e3f2fd;
  color: #2196f3;
  font-size: 22rpx;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}

.policy-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.policy-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.policy-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.policy-date {
  font-size: 24rpx;
  color: #999;
}

.policy-arrow {
  font-size: 24rpx;
  color: #ff6b6b;
}

.policy-detail {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.detail-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.detail-popup {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  animation: slideUp 0.3s;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #eee;
}

.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  padding-right: 20rpx;
}

.detail-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

.detail-content {
  height: calc(80vh - 100rpx);
  padding: 32rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.detail-tag {
  padding: 6rpx 16rpx;
  background: #e3f2fd;
  color: #2196f3;
  font-size: 22rpx;
  border-radius: 6rpx;
}

.detail-date {
  font-size: 24rpx;
  color: #999;
}

.detail-body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}
