.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.content {
  flex: 1;
  overflow: hidden;
}

.swiper-container {
  position: relative;
  background: #000;
}

.image-swiper {
  height: 500rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.swiper-counter {
  position: absolute;
  right: 24rpx;
  bottom: 80rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.media-tabs {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: rgba(0, 0, 0, 0.6);
}

.media-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  color: #fff;
  font-size: 26rpx;
  position: relative;
}

.media-tab.active {
  color: #ff6b6b;
}

.media-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #ff6b6b;
  border-radius: 2rpx;
}

.media-tab .count,
.media-tab .vr-badge,
.media-tab .play-icon {
  font-size: 20rpx;
  margin-left: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.2);
}

.vr-container, .video-container {
  height: 500rpx;
  background: #000;
}

.vr-view, .video-player {
  width: 100%;
  height: 100%;
}

.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.price-section {
  padding-top: 40rpx;
}

.price-info {
  margin-bottom: 20rpx;
}

.price {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.price-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.price-unit {
  font-size: 26rpx;
  color: #ff6b6b;
  margin-left: 4rpx;
}

.price-desc {
  font-size: 24rpx;
  color: #999;
}

.house-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.title-section .house-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.house-meta {
  display: flex;
  gap: 32rpx;
  font-size: 24rpx;
  color: #999;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  display: flex;
  margin-bottom: 24rpx;
}

.info-item:nth-child(odd) {
  padding-right: 20rpx;
}

.info-item:nth-child(even) {
  padding-left: 20rpx;
}

.info-label {
  color: #999;
  font-size: 26rpx;
  flex-shrink: 0;
  width: 80rpx;
}

.info-value {
  color: #333;
  font-size: 26rpx;
  flex: 1;
}

.features-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  width: calc(50% - 10rpx);
  font-size: 26rpx;
  color: #333;
}

.feature-icon {
  color: #4caf50;
  margin-right: 8rpx;
  font-weight: bold;
}

.facilities-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.facility-item {
  width: calc(25% - 18rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.facility-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.desc-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.desc-content.collapsed {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.desc-more {
  text-align: center;
  color: #ff6b6b;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.desc-more .arrow {
  margin-left: 4rpx;
}

.community-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.community-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.community-info {
  flex: 1;
  min-width: 0;
}

.community-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.community-address {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.community-stats {
  font-size: 22rpx;
  color: #666;
  display: flex;
  gap: 20rpx;
}

.community-arrow {
  color: #ccc;
  font-size: 28rpx;
  flex-shrink: 0;
}

.community-facilities {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.map-container {
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.map-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.map-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.map-address {
  font-size: 28rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.map-hint {
  font-size: 22rpx;
  opacity: 0.8;
}

.peripheral-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.peripheral-item {
  width: calc(50% - 8rpx);
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.peripheral-name {
  flex: 1;
}

.peripheral-type {
  margin-right: 8rpx;
  color: #999;
}

.peripheral-distance {
  color: #ff6b6b;
}

.agent-card {
  display: flex;
  align-items: center;
}

.agent-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.agent-info {
  flex: 1;
  min-width: 0;
}

.agent-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}

.agent-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: #e3f2fd;
  color: #2196f3;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.agent-badge.landlord {
  background: #e8f5e9;
  color: #4caf50;
}

.agent-company {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.agent-stats {
  font-size: 22rpx;
  color: #999;
  display: flex;
  gap: 20rpx;
}

.agent-stats text:last-child {
  color: #4caf50;
}

.agent-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  font-size: 32rpx;
  margin: 0;
  border: none;
}

.action-btn.call {
  background: #e8f5e9;
  color: #4caf50;
}

.action-btn.chat {
  background: #e3f2fd;
  color: #2196f3;
}

.action-btn::after {
  border: none;
}

.bottom-space {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.bottom-actions {
  display: flex;
  gap: 8rpx;
  margin-right: 20rpx;
}

.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  color: #666;
  background: none;
  border: none;
  margin: 0;
  line-height: 1.2;
}

.bottom-action::after {
  border: none;
}

.bottom-action .action-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.bottom-btns {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.contact-btn, .appointment-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
}

.contact-btn::after, .appointment-btn::after {
  border: none;
}

.preview-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-swiper {
  width: 100%;
  height: 100%;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-counter {
  position: absolute;
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #fff;
  font-size: 28rpx;
  background: rgba(0, 0, 0, 0.6);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

.preview-close {
  position: absolute;
  top: 60rpx;
  right: 32rpx;
  color: #fff;
  font-size: 40rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
}

.appointment-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.appointment-popup {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 80vh;
  animation: slideUp 0.3s;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.appointment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #eee;
}

.appointment-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.appointment-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

.appointment-form {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.form-picker {
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  min-height: 120rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.appointment-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
