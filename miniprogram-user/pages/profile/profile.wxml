<view class="page">
  <view class="header">
    <view class="user-info" bindtap="goLogin" wx:if="{{!userInfo}}">
      <image class="avatar" src="/images/default-avatar.png"></image>
      <view class="user-detail">
        <text class="login-tip">点击登录</text>
        <text class="login-desc">登录后体验更多功能</text>
      </view>
      <text class="arrow">></text>
    </view>
    <view class="user-info" wx:if="{{userInfo}}">
      <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}"></image>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname || '用户'}}</text>
        <text class="phone">{{userInfo.phone}}</text>
      </view>
      <text class="edit-btn" bindtap="editProfile">编辑</text>
    </view>
    <view class="user-stats" wx:if="{{userInfo}}">
      <view class="stat-item" bindtap="goFavorites">
        <text class="stat-number">{{stats.favorites}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat-item" bindtap="goHistory">
        <text class="stat-number">{{stats.viewHistory}}</text>
        <text class="stat-label">浏览</text>
      </view>
      <view class="stat-item" bindtap="goAppointment">
        <text class="stat-number">{{stats.appointments}}</text>
        <text class="stat-label">预约</text>
      </view>
      <view class="stat-item" bindtap="goDemand">
        <text class="stat-number">{{stats.demands}}</text>
        <text class="stat-label">需求</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-title">我的服务</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goFavorites">
        <text class="menu-icon">❤️</text>
        <text class="menu-name">我的收藏</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goHistory">
        <text class="menu-icon">👁</text>
        <text class="menu-name">浏览历史</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goAppointment">
        <text class="menu-icon">📅</text>
        <text class="menu-name">看房预约</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goDemand">
        <text class="menu-icon">📋</text>
        <text class="menu-name">我的需求</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-title">发布需求</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goPublishDemand" data-type="rent">
        <text class="menu-icon">🏠</text>
        <text class="menu-name">发布求租</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goPublishDemand" data-type="buy">
        <text class="menu-icon">🏡</text>
        <text class="menu-name">发布求购</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-title">更多服务</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goTools">
        <text class="menu-icon">🧰</text>
        <text class="menu-name">实用工具</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goAgent">
        <text class="menu-icon">👔</text>
        <text class="menu-name">经纪人入口</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goMessages">
        <text class="menu-icon">🔔</text>
        <text class="menu-name">消息通知</text>
        <view class="badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-name">关于我们</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <button class="logout-btn" wx:if="{{userInfo}}" bindtap="logout">退出登录</button>
</view>
