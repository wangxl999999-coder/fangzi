<view class="page">
  <view class="tabs">
    <view class="tab {{activeTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab {{activeTab === 'system' ? 'active' : ''}}" bindtap="switchTab" data-tab="system">系统通知</view>
    <view class="tab {{activeTab === 'appointment' ? 'active' : ''}}" bindtap="switchTab" data-tab="appointment">预约通知</view>
    <view class="tab {{activeTab === 'activity' ? 'active' : ''}}" bindtap="switchTab" data-tab="activity">活动通知</view>
  </view>

  <scroll-view scroll-y class="message-list" bindscrolltolower="loadMore">
    <view class="message-item" wx:for="{{messageList}}" wx:key="_id" bindtap="viewMessage" data-id="{{item._id}}">
      <view class="message-icon" style="background: {{item.iconBg}}">
        <text>{{item.icon}}</text>
      </view>
      <view class="message-content">
        <view class="message-header">
          <text class="message-title">{{item.title}}</text>
          <text class="message-time">{{item.time}}</text>
        </view>
        <view class="message-desc {{item.read ? '' : 'unread'}}">{{item.content}}</view>
      </view>
      <view class="unread-dot" wx:if="{{!item.read}}"></view>
    </view>

    <view class="empty" wx:if="{{messageList.length === 0 && !loading}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无消息</text>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="no-more" wx:if="{{noMore && messageList.length > 0}}">— 没有更多消息了 —</view>
  </scroll-view>
</view>
