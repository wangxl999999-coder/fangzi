.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.type-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 32rpx;
  gap: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 40rpx;
  background: #f5f5f5;
}

.tab.active {
  background: #ff6b6b;
  color: #fff;
}

.form-scroll {
  flex: 1;
  overflow: hidden;
}

.form-section {
  padding: 24rpx 32rpx;
}

.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.checkbox-item {
  padding: 16rpx 28rpx;
  border: 1rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
}

.checkbox-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
  color: #ff6b6b;
}

.range-picker, .price-input {
  display: flex;
  align-items: center;
}

.picker, .input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.separator {
  margin: 0 16rpx;
  color: #999;
}

.unit {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.picker-full {
  height: 72rpx;
  line-height: 72rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.footer {
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
}

.submit-btn::after {
  border: none;
}
