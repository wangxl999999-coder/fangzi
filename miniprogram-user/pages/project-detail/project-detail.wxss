.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.content {
  flex: 1;
  overflow: hidden;
}

.image-swiper {
  height: 400rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #333;
}

.project-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.project-price {
  margin-bottom: 16rpx;
}

.price {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.price-unit {
  font-size: 26rpx;
  color: #ff6b6b;
}

.project-info {
  display: flex;
  gap: 12rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  display: flex;
  margin-bottom: 20rpx;
}

.label {
  color: #999;
  font-size: 26rpx;
  width: 100rpx;
}

.value {
  color: #333;
  font-size: 26rpx;
  flex: 1;
}

.house-type-list {
  gap: 16rpx;
}

.house-type-item {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.house-type-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.house-type-area {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.house-type-price {
  font-size: 26rpx;
  color: #ff6b6b;
  font-weight: 500;
}

.desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.facilities {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.address {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.peripheral-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #666;
}

.distance {
  color: #ff6b6b;
}

.bottom-space {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
}

.bottom-bar .btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
}
